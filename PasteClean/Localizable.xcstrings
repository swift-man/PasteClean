        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣기 ⌘V → 정리 ⌥O → 오른쪽에서 복사"
          }
        }
      }
    },
    "Removes blank lines and trailing whitespace, then rewrites indentation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes blank lines and trailing whitespace, then rewrites indentation."
