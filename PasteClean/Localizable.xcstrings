    "Copying from a rendered Markdown code block leaves a blank line between every line, trailing whitespace at the ends, and indentation that does not match your project. This fixes all of it at once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying from a rendered Markdown code block leaves a blank line between every line, trailing whitespace at the ends, and indentation that does not match your project. This fixes all of it at once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown으로 렌더링된 코드 블록에서 복사하면 줄마다 빈 줄이 끼어들고, 줄 끝에 공백이 남고, 들여쓰기 폭이 프로젝트와 어긋납니다. 한 번에 정리합니다."
          }
        }
      }
    },
    "Paste into Input on the left. ⌘V goes there no matter what has focus.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste into Input on the left. ⌘V goes there no matter what has focus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 Input에 붙여넣습니다. ⌘V를 누르면 어디에 포커스가 있든 Input으로 들어갑니다."
          }
        }
      }
    },
    "Press ⌥O, or the Clean button, and the result appears in Output on the right.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press ⌥O, or the Clean button, and the result appears in Output on the right."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥O를 누르거나 정리 버튼을 누르면 오른쪽 Output에 결과가 나옵니다."
          }
        }
      }
    },
    "Take the result with the Copy button in the Output header.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take the result with the Copy button in the Output header."
