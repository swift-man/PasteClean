        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 없이 실행하면 파일 전체를 정리합니다. ⌘Z로 되돌릴 수 있습니다."
          }
        }
      }
    },
    "Indentation follows Xcode's own settings, so there is nothing to configure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Indentation follows Xcode's own settings, so there is nothing to configure."
