    "Paste ⌘V → Clean ⌥O → Copy from the right": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste ⌘V → Clean ⌥O → Copy from the right"
